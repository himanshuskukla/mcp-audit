  "keywords": ["mcp", "mcp-security", "mcp-audit", "mcp-scanner", "security-scanner", "model-context-protocol", "owasp", "ai-agents", "ai-security", "claude", "cursor", "vscode", "devsecops", "supply-chain-security", "tool-poisoning", "hardcoded-secrets", "cli"],
