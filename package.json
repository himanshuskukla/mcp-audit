  "engines": { "node": ">=20" },
  "devDependencies": {
    "@types/node": "^25.9.2",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  },
  "dependencies": {
    "chalk": "^5.6.2",
    "commander": "^15.0.0"
